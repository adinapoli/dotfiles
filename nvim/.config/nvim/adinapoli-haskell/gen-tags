#!/bin/bash

#set -x pipefail

tags_root=$(git rev-parse --show-toplevel)

if [[ -z $tags_root ]]; then
    tags_root=$(pwd)
    echo "Can't find git root, using ${tags_root} as tag root"
fi

#hs_files=$(find $tags_root -not -path '*/\.*' -not -path 'dist-newstyle' -not -path 'dist' -iname '*.hs' -o -iname '*.hsc' | tr "\n" " ")

# Exclude other git worktrees nested under tags_root so tags don't leak
# across branches when worktrees live inside the main checkout.
excludes=()
while IFS= read -r wt; do
    [[ -z $wt ]] && continue
    [[ $wt == "$tags_root" ]] && continue
    if [[ $wt == "$tags_root"/* ]]; then
        excludes+=( --glob "!${wt#$tags_root/}/**" )
    fi
done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')

hs_files=$(rg "$tags_root" --files --type haskell "${excludes[@]}")

OUTDIR=${2:-tags}

fast-tags -o ${tags_root}/$OUTDIR --no-module-tags --nomerge $hs_files
